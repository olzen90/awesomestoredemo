---
import "../styles/global.css";
import ClerkScript from "../components/ClerkScript.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

type Props = {
	title?: string;
	description?: string;
};

const { title = "Awesome Store — Useful things, chosen with care", description = "A considered collection of everyday objects, clothing, and tools." } = Astro.props;
const pageTitle = title.includes("Awesome Store") ? title : `${title} — Awesome Store`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{pageTitle}</title>
		<ClerkScript />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<div class="toast" data-toast role="status" aria-live="polite"></div>
		<script src="../scripts/storefront.ts"></script>
	</body>
</html>
