---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPages } from "../../lib/catalog";

export function getStaticPaths() {
	return blogPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---

<BaseLayout title={`${page.title} — Awesome Store`} description={page.text.slice(0, 150)}>
	<article class="shell article">
		<!-- Clerk injection context: use data-clerk-page-id for the current blog page. -->
		<div id="clerk-page-context" class="sr-only" data-clerk-context="page" data-clerk-id={page.id} data-page-id={page.id} data-clerk-page-id={page.id} data-clerk-page-type={page.type}></div>
		<div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/blog">Journal</a><span>/</span><span>{page.title}</span></div>
		<p class="eyebrow">{page.date} · Awesome Store Journal</p>
		<h1>{page.title}</h1>
		<p class="article-meta">A short note from the people behind the collection.</p>
		<img class="article-image" src={page.image} alt="" width="900" height="520" />
		<div class="article-body"><p>{page.text}</p><p>There is no perfect way to build a collection. There is only the patient work of noticing what gets used, what gets kept, and what makes the ordinary parts of a day feel a little more intentional.</p></div>
	</article>
</BaseLayout>
