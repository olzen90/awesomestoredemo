---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClerkSlot from "../components/ClerkSlot.astro";
import ProductGrid from "../components/ProductGrid.astro";
import { blogPages, featuredProducts, newProducts, products, storeName, topLevelCategories } from "../lib/catalog";
---

<BaseLayout title={`${storeName} — Useful things, chosen with care`} description="A considered collection of everyday objects, clothing, and tools from Awesome Store.">
	<section class="hero shell">
		<div class="hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">The new everyday</p>
				<h1>Things that earn their place.</h1>
				<p>A considered collection of clothing, objects, and tools for the way you actually live. Start with something useful.</p>
				<div class="hero-actions">
					<a class="button" href="#featured">Shop the collection <span aria-hidden="true">↗</span></a>
					<a class="text-link" href="/blog">Read the journal <span aria-hidden="true">→</span></a>
				</div>
			</div>
			<div class="hero-collage" aria-label="A selection from the Awesome Store collection">
				{products.slice(0, 4).map((product) => (
					<a class="collage-tile" href={product.url}>
						<img src={product.image} alt={product.name} width="720" height="720" />
						<figcaption><span>{product.department}</span><span>↗</span></figcaption>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="category-strip shell">
		<div class="section-top"><div><p class="eyebrow">Browse by mood</p><h2>Find your next favorite.</h2></div><p>Eight departments, one relaxed point of view.</p></div>
		<div class="category-cards">
			{topLevelCategories.map((category) => (
				<a class="category-card" href={category.url}>
					<span class="category-dot" aria-hidden="true"></span>
					<h3>{category.name}</h3>
					<p>{category.description}</p>
				</a>
			))}
		</div>
	</section>

	<section class="product-section shell" id="featured">
		<div class="section-top"><div><p class="eyebrow">Selected for you</p><h2>Good things, right now.</h2></div><a class="text-link" href="/search">View everything <span aria-hidden="true">→</span></a></div>
		<ProductGrid products={featuredProducts} label="Homepage - Featured" />
	</section>

	<section class="split-banner shell">
		<div><p class="banner-kicker">The Awesome Store edit</p><h2>More considered. Less complicated.</h2><p>We look for the small decisions that make a product feel right: the weight, the texture, the way it holds up.</p><a class="text-link" href="/blog/the-case-for-fewer-better-things">Why we choose this way <span aria-hidden="true">→</span></a></div>
		<div><p class="banner-kicker">Clerk-ready module</p><h2>Recommendations that feel personal.</h2><p>The fallback below is ready to be replaced by a Clerk Element when your public key is configured.</p><ClerkSlot api="recommendations/visitor/popular" label="Homepage - Recommendations" limit={4}><ProductGrid products={newProducts.slice(0, 4)} compact label="Homepage - Recommendations" /></ClerkSlot></div>
	</section>

	<section class="product-section shell">
		<div class="section-top"><div><p class="eyebrow">From the journal</p><h2>Notes on living well.</h2></div><a class="text-link" href="/blog">All stories <span aria-hidden="true">→</span></a></div>
		<div class="blog-grid">
			{blogPages.map((page) => (
				<a class="blog-card" href={page.url}>
					<img class="blog-card-image" src={page.image} alt="" width="720" height="380" />
					<p class="banner-kicker">{page.date}</p>
					<h2>{page.title}</h2>
					<p>{page.text.slice(0, 135)}…</p>
					<span class="text-link">Read story <span aria-hidden="true">→</span></span>
				</a>
			))}
		</div>
	</section>
</BaseLayout>
