---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Your bag — Awesome Store" description="Review the products in your Awesome Store bag.">
	<section class="shell basket-page">
		<!-- Clerk injection context: data-clerk-cart-product-ids is updated from the local basket. -->
		<div id="clerk-cart-context" class="sr-only" data-clerk-context="cart" data-clerk-cart-ids="" data-cart-product-ids="" data-clerk-cart-product-ids="" data-clerk-cart-items="[]"></div>
		<div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Your bag</span></div>
		<h1>Your bag.</h1>
		<div class="basket-layout">
			<div>
				<div class="cart-items" data-cart-items></div>
				<div class="cart-empty" data-cart-empty><h2>Your bag is ready when you are.</h2><p>Add a few pieces from the collection and they’ll show up here.</p><a class="text-link" href="/">Keep browsing <span aria-hidden="true">→</span></a></div>
			</div>
			<aside class="summary-card"><h2>Order summary</h2><div class="summary-line"><span>Subtotal</span><strong data-cart-subtotal>€0.00</strong></div><div class="summary-line"><span>Delivery</span><span>Calculated at checkout</span></div><div class="summary-line total"><span>Total</span><strong data-cart-total>€0.00</strong></div><a class="button" data-checkout-link href="/checkout/success">Continue to demo checkout <span aria-hidden="true">→</span></a><p class="clerk-demo-note">This is a visual demo — no payment is taken.</p></aside>
		</div>
	</section>
</BaseLayout>
