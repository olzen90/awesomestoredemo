---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Your cart — Awesome Store" description="Review the products in your Awesome Store cart.">
	<section class="shell cart-page">
		<!-- Existing webshop context: the cart product IDs are updated from the local cart. -->
		<div id="cart-context" class="sr-only" data-context="cart" data-cart-ids="" data-cart-product-ids="" data-cart-items="[]"></div>
		<div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Your cart</span></div>
		<h1>Your cart.</h1>
		<div class="cart-layout">
			<div>
				<div class="cart-items" data-cart-items></div>
				<div class="cart-empty" data-cart-empty><h2>Your cart is ready when you are.</h2><p>Add a few pieces from the collection and they’ll show up here.</p><a class="text-link" href="/">Keep browsing <span aria-hidden="true">→</span></a></div>
			</div>
			<aside class="summary-card"><h2>Order summary</h2><div class="summary-line"><span>Subtotal</span><strong data-cart-subtotal>€0.00</strong></div><div class="summary-line"><span>Delivery</span><span>Calculated at checkout</span></div><div class="summary-line total"><span>Total</span><strong data-cart-total>€0.00</strong></div><a class="button" data-checkout-link href="/checkout/success">Continue to checkout <span aria-hidden="true">→</span></a></aside>
		</div>
	</section>
</BaseLayout>
