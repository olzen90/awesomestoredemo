---
type Props = {
	api?: string;
	template?: string;
	label: string;
	limit?: number;
	category?: number;
	products?: number[];
	instantSearch?: string;
	children?: unknown;
};

const { api, template, label, limit = 8, category, products, instantSearch } = Astro.props;
---

<div class="clerk-slot" data-clerk-slot={label}>
	<span
		class="clerk"
		data-api={api}
		data-template={template}
		data-limit={limit}
		data-labels={JSON.stringify([label])}
		data-category={category}
		data-products={products ? JSON.stringify(products) : undefined}
		data-instant-search={instantSearch}
	>
		<div class="clerk-fallback">
			<slot />
		</div>
	</span>
</div>
