---
const publicKey = import.meta.env.PUBLIC_CLERK_API_KEY as string | undefined;
---

{publicKey && (
	<script is:inline define:vars={{ publicKey }}>
		(function (w, d) {
			const e = d.createElement("script");
			e.type = "text/javascript";
			e.async = true;
			e.src = "https://cdn.clerk.io/clerk.js";
			const s = d.getElementsByTagName("script")[0];
			s.parentNode?.insertBefore(e, s);
			w.__clerk_q = w.__clerk_q || [];
			w.Clerk = w.Clerk || function (...args) {
				w.__clerk_q.push(args);
			};
			w.Clerk("config", { key: publicKey });
		})(window, document);
	</script>
)}
